# The wide mask is loaded before the loop and reused by the loop body.
[arm64]
CHECK: (?m)^_masked:
CHECK: movz x11, #57072
CHECK: movk x11, #39612, lsl #16
CHECK: movk x11, #22136, lsl #32
CHECK: movk x11, #4660, lsl #48
CHECK-NOT: movz x11
CHECK-NOT: movk x11
CHECK: (?m)^L1:
CHECK-NOT: movz x11
CHECK-NOT: movk x11
CHECK: (?m)^L3:

[amd64]
CHECK: (?m)^# L[0-9]+: masked$
CHECK: (?m)^movabs r13,0x123456789abcdef0$
CHECK: (?m)^jmp L[0-9]+$
CHECK: (?m)^L[0-9]+:$
CHECK-NOT: movabs r13,0x123456789abcdef0
CHECK: (?m)^L[0-9]+:$
